---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<BaseLayout
  title="Crop Image — Crop to Exact Aspect Ratio | FormFix"
  description="Crop images to exact aspect ratios and dimensions for exam application uploads. Free drag-and-drop crop tool with touch support."
>
  <section class="section">
    <div class="container">
      <div class="tool-header">
        <h1>Crop Image</h1>
        <p>Crop your image to the exact aspect ratio and dimensions needed. Drag, zoom, and pan — with full touch support on mobile.</p>
      </div>

      <div id="crop-app">
        <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label="Upload image">
          <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="upload-zone-text">Drop image here or click to upload</span>
          <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB</span>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden />
        </div>

        <div id="workspace" class="workspace crop-workspace" hidden>
          <div class="crop-container">
            <img id="crop-source" alt="Image to crop" />
          </div>
          <div class="workspace-controls">
            <div class="card">
              <h3 class="controls-title">Crop Settings</h3>
              <div class="control-group">
                <label class="label" for="aspect-select">Aspect ratio</label>
                <select id="aspect-select" class="input">
                  <option value="free">Free</option>
                  <option value="1">1:1 (Square)</option>
                  <option value="0.8695">200:230 (IBPS Photo)</option>
                  <option value="2.3333">140:60 (IBPS Signature)</option>
                  <option value="0.75">3:4 (Portrait)</option>
                  <option value="1.3333">4:3 (Landscape)</option>
                </select>
              </div>
              <button id="crop-btn" class="btn btn-primary" style="width:100%">Apply Crop</button>
            </div>
            <div id="result-panel" class="card" hidden>
              <h3 class="controls-title">Result</h3>
              <dl class="file-info">
                <dt>Dimensions</dt><dd id="res-dim">—</dd>
                <dt>Size</dt><dd id="res-size">—</dd>
              </dl>
              <div class="result-preview-box">
                <img id="result-preview" alt="Cropped result" />
              </div>
              <button id="download-btn" class="btn btn-success" style="width:100%;margin-top:var(--space-3)">Download</button>
            </div>
            <button id="new-file-btn" class="btn btn-ghost" style="width:100%" hidden>Process Another File</button>
          </div>
        </div>
        <div id="error-panel" class="alert alert-error" role="alert" hidden></div>
      </div>
    </div>
  </section>

  <!-- Ad Slot — Below tool content, above footer -->
  <AdSlot slotId="tool-crop" format="responsive" />

</BaseLayout>

<script>
  import { validateFile, cropImage, createPreviewURL, downloadFile, getExtension } from '../../lib/image-engine.js';
  import Cropper from 'cropperjs';

  const uploadArea = document.getElementById('upload-area');
  const fileInput = document.getElementById('file-input');
  const workspace = document.getElementById('workspace');
  const cropSource = document.getElementById('crop-source');
  const cropBtn = document.getElementById('crop-btn');
  const downloadBtn = document.getElementById('download-btn');
  const newFileBtn = document.getElementById('new-file-btn');
  const aspectSelect = document.getElementById('aspect-select');
  const resultPanel = document.getElementById('result-panel');
  const resultPreview = document.getElementById('result-preview');
  const errorPanel = document.getElementById('error-panel');

  let currentFile = null;
  let resultBlob = null;
  let cropper = null;
  let previewURL = null;
  let resultURL = null;

  uploadArea?.addEventListener('click', () => fileInput?.click());
  uploadArea?.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput?.click(); } });
  uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
  uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea?.addEventListener('drop', (e) => { e.preventDefault(); uploadArea.classList.remove('drag-over'); if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]); });
  fileInput?.addEventListener('change', (e) => { if (e.target.files?.[0]) handleFile(e.target.files[0]); });

  aspectSelect?.addEventListener('change', () => {
    if (cropper) {
      const val = aspectSelect.value;
      cropper.setAspectRatio(val === 'free' ? NaN : parseFloat(val));
    }
  });

  cropBtn?.addEventListener('click', handleCrop);
  downloadBtn?.addEventListener('click', () => {
    if (resultBlob && currentFile) {
      const ext = getExtension(currentFile.type);
      downloadFile(resultBlob, `${currentFile.name.replace(/\.[^.]+$/, '')}_cropped.${ext}`);
    }
  });
  newFileBtn?.addEventListener('click', resetUI);

  async function handleFile(file) {
    errorPanel.hidden = true;
    const v = await validateFile(file);
    if (!v.valid) { errorPanel.hidden = false; errorPanel.textContent = v.errors.join(' '); return; }
    currentFile = file;

    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = createPreviewURL(file);
    cropSource.src = previewURL;

    cropSource.onload = () => {
      if (cropper) cropper.destroy();
      cropper = new Cropper(cropSource, {
        viewMode: 1,
        dragMode: 'move',
        responsive: true,
        autoCropArea: 0.9,
        guides: true,
        center: true,
        highlight: false,
        background: true,
      });
    };

    uploadArea.hidden = true;
    workspace.hidden = false;
    resultPanel.hidden = true;
    newFileBtn.hidden = true;
  }

  async function handleCrop() {
    if (!cropper || !currentFile) return;
    const data = cropper.getData(true);
    cropBtn.disabled = true; cropBtn.textContent = 'Cropping...';
    try {
      const result = await cropImage(currentFile, {
        x: data.x, y: data.y, width: data.width, height: data.height
      }, { format: currentFile.type });
      resultBlob = result.blob;
      if (resultURL) URL.revokeObjectURL(resultURL);
      resultURL = createPreviewURL(result.blob);
      resultPreview.src = resultURL;
      document.getElementById('res-dim').textContent = `${result.width} × ${result.height} px`;
      document.getElementById('res-size').textContent = `${(result.blob.size / 1024).toFixed(1)} KB`;
      resultPanel.hidden = false;
      newFileBtn.hidden = false;
    } catch (err) { errorPanel.hidden = false; errorPanel.textContent = err.message; }
    finally { cropBtn.disabled = false; cropBtn.textContent = 'Apply Crop'; }
  }

  function resetUI() {
    currentFile = null; resultBlob = null;
    if (cropper) { cropper.destroy(); cropper = null; }
    if (previewURL) { URL.revokeObjectURL(previewURL); previewURL = null; }
    if (resultURL) { URL.revokeObjectURL(resultURL); resultURL = null; }
    uploadArea.hidden = false; workspace.hidden = true;
    resultPanel.hidden = true; newFileBtn.hidden = true;
    errorPanel.hidden = true; fileInput.value = '';
  }
</script>

<style>
  .tool-header { margin-bottom: clamp(1.25rem, 3vw, 2rem); }
  .tool-header h1 { margin-bottom: var(--space-2); }
  .tool-header p { color: var(--color-text-secondary); font-size: clamp(0.875rem, 1.5vw + 0.4rem, 1rem); }
  .controls-title { font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: var(--space-3); }
  .control-group { margin-bottom: var(--space-4); }
  .crop-workspace { gap: var(--space-6); width: 100%; }
  .crop-container {
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-height: clamp(260px, 45vh, 500px);
    width: 100%;
    touch-action: pan-y;
  }
  .crop-container img { display: block; max-width: 100%; }
  .result-preview-box { margin-top: var(--space-3); background: var(--color-surface-muted); border-radius: var(--radius-md); padding: var(--space-3); text-align: center; }
  .result-preview-box img { max-width: 100%; max-height: clamp(160px, 30vh, 220px); }
</style>

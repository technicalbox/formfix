---
import BaseLayout from '../../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Compress an Image to a Specific File Size',
  step: [
    { '@type': 'HowToStep', name: 'Upload your image', text: 'Click the upload area or drag and drop a JPG, PNG, or WebP image.' },
    { '@type': 'HowToStep', name: 'Set target size', text: 'Enter your target file size in KB (e.g., 50 KB for SSC applications).' },
    { '@type': 'HowToStep', name: 'Download compressed image', text: 'FormFix compresses your image using a smart algorithm and you can download the result.' },
  ],
};
---

<BaseLayout
  title="Compress Image — Reduce File Size to ≤ Target KB | FormFix"
  description="Compress JPG, PNG, or WebP images to a specific file size. Reduce to ≤ 20 KB, 50 KB, 100 KB, or any target. Free, instant, processed in your browser."
  structuredData={structuredData}
>

  <section class="section">
    <div class="container">
      <div class="tool-header">
        <h1>Compress Image</h1>
        <p>Reduce your image file size to ≤ target KB for exam and application uploads. Processed entirely in your browser — files are never uploaded.</p>
      </div>

      <div id="compress-app" class="compress-app">
        <!-- Upload Zone -->
        <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label="Upload image — JPG, PNG, or WebP, maximum 25 MB">
          <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="upload-zone-text">Drop image here or click to upload</span>
          <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB</span>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden aria-label="Choose image file" />
        </div>

        <!-- Workspace (hidden until file uploaded) -->
        <div id="workspace" class="workspace" hidden>
          <div class="workspace-preview">
            <img id="preview-img" alt="Image preview" />
          </div>

          <div class="workspace-controls">
            <!-- File info -->
            <div class="card">
              <h3 class="controls-title">Original File</h3>
              <dl class="file-info" id="original-info">
                <dt>Name</dt>
                <dd id="info-name">—</dd>
                <dt>Dimensions</dt>
                <dd id="info-dimensions">—</dd>
                <dt>Size</dt>
                <dd id="info-size">—</dd>
                <dt>Format</dt>
                <dd id="info-format">—</dd>
              </dl>
            </div>

            <!-- Compression controls -->
            <div class="card">
              <h3 class="controls-title">Compression Target</h3>
              <div class="control-group">
                <label class="label" for="target-kb">Target size (KB)</label>
                <div class="target-input-row">
                  <span class="target-prefix">≤</span>
                  <input type="number" id="target-kb" class="input target-input" value="50" min="1" max="10000" step="1" />
                  <span class="target-suffix">KB</span>
                </div>
              </div>

              <div class="quick-targets">
                <button class="btn btn-sm btn-ghost quick-target" data-kb="20">20 KB</button>
                <button class="btn btn-sm btn-ghost quick-target" data-kb="50">50 KB</button>
                <button class="btn btn-sm btn-ghost quick-target" data-kb="100">100 KB</button>
                <button class="btn btn-sm btn-ghost quick-target" data-kb="200">200 KB</button>
              </div>

              <div class="control-group">
                <label class="label" for="output-format">Output format</label>
                <select id="output-format" class="input">
                  <option value="image/jpeg">JPG (recommended)</option>
                  <option value="image/png">PNG</option>
                  <option value="image/webp">WebP</option>
                </select>
              </div>

              <button id="compress-btn" class="btn btn-primary" style="width:100%">
                Compress Image
              </button>
            </div>

            <!-- Result (hidden until compressed) -->
            <div id="result-panel" class="card" hidden>
              <h3 class="controls-title">Result</h3>
              <dl class="file-info" id="result-info">
                <dt>Original</dt>
                <dd id="result-original">—</dd>
                <dt>Target</dt>
                <dd id="result-target">—</dd>
                <dt>Result</dt>
                <dd id="result-size">—</dd>
                <dt>Quality</dt>
                <dd id="result-quality">—</dd>
              </dl>

              <div id="result-status" class="alert" role="status" aria-live="polite"></div>

              <button id="download-btn" class="btn btn-success" style="width:100%;margin-top:var(--space-3)" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Download
              </button>
            </div>

            <!-- Progress -->
            <div id="progress-panel" hidden>
              <div class="progress-bar">
                <div class="progress-bar-fill" id="progress-fill" style="width:0%"></div>
              </div>
              <p class="progress-text" id="progress-text">Compressing...</p>
            </div>

            <!-- New file button -->
            <button id="new-file-btn" class="btn btn-ghost" style="width:100%" hidden>
              Process Another File
            </button>
          </div>
        </div>

        <!-- Error display -->
        <div id="error-panel" class="alert alert-error" role="alert" hidden></div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="container">
      <h2>How Image Compression Works</h2>
      <p style="margin-top:var(--space-3);color:var(--color-text-secondary);font-size:var(--text-sm);">
        FormFix uses a binary search algorithm to find the optimal compression quality. It tries different quality levels (up to 8 iterations) to find the best quality that keeps your file under the target size. If the target is impossible to achieve without severe quality loss, FormFix will explain why and suggest reducing the image dimensions first.
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  import { validateFile, compressToSize, getImageMetadata, createPreviewURL, downloadFile, formatBytes, getExtension } from '../../lib/image-engine.js';

  const uploadArea = document.getElementById('upload-area');
  const fileInput = document.getElementById('file-input');
  const workspace = document.getElementById('workspace');
  const previewImg = document.getElementById('preview-img');
  const compressBtn = document.getElementById('compress-btn');
  const downloadBtn = document.getElementById('download-btn');
  const newFileBtn = document.getElementById('new-file-btn');
  const targetKbInput = document.getElementById('target-kb');
  const outputFormat = document.getElementById('output-format');
  const resultPanel = document.getElementById('result-panel');
  const progressPanel = document.getElementById('progress-panel');
  const progressFill = document.getElementById('progress-fill');
  const progressText = document.getElementById('progress-text');
  const errorPanel = document.getElementById('error-panel');

  let currentFile = null;
  let resultBlob = null;
  let previewURL = null;

  // Parse URL params for preset target
  const params = new URLSearchParams(window.location.search);
  const presetKB = params.get('kb');
  if (presetKB && targetKbInput) {
    targetKbInput.value = presetKB;
  }

  // Upload zone interactions
  uploadArea?.addEventListener('click', () => fileInput?.click());
  uploadArea?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput?.click();
    }
  });

  uploadArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('drag-over');
  });

  uploadArea?.addEventListener('dragleave', () => {
    uploadArea.classList.remove('drag-over');
  });

  uploadArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) handleFile(file);
  });

  fileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) handleFile(file);
  });

  // Quick target buttons
  document.querySelectorAll('.quick-target').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kb = btn.dataset.kb;
      if (targetKbInput) targetKbInput.value = kb;
    });
  });

  // Compress button
  compressBtn?.addEventListener('click', handleCompress);

  // Download
  downloadBtn?.addEventListener('click', () => {
    if (resultBlob) {
      const ext = getExtension(outputFormat?.value || 'image/jpeg');
      const name = currentFile ? currentFile.name.replace(/\.[^.]+$/, '') : 'image';
      downloadFile(resultBlob, `${name}_formfix.${ext}`);
    }
  });

  // New file
  newFileBtn?.addEventListener('click', () => {
    resetUI();
  });

  async function handleFile(file) {
    showError('');
    const validation = await validateFile(file);

    if (!validation.valid) {
      showError(validation.errors.join(' '));
      return;
    }

    currentFile = file;

    // Show preview
    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = createPreviewURL(file);
    if (previewImg) previewImg.src = previewURL;

    // Show metadata
    const meta = await getImageMetadata(file);
    setText('info-name', file.name);
    setText('info-dimensions', `${meta.width} × ${meta.height} px`);
    setText('info-size', `${meta.sizeKB} KB`);
    setText('info-format', file.type.replace('image/', '').toUpperCase());

    // Show warnings
    if (validation.warnings.length > 0) {
      showError(validation.warnings.join(' '), 'warning');
    }

    // Show workspace
    uploadArea.hidden = true;
    workspace.hidden = false;
    resultPanel.hidden = true;
    downloadBtn.hidden = true;
    newFileBtn.hidden = true;
  }

  async function handleCompress() {
    if (!currentFile) return;

    const targetKB = parseInt(targetKbInput?.value || '50', 10);
    if (isNaN(targetKB) || targetKB < 1) {
      showError('Please enter a valid target size in KB.');
      return;
    }

    const format = outputFormat?.value || 'image/jpeg';

    // Show progress
    compressBtn.disabled = true;
    compressBtn.textContent = 'Compressing...';
    progressPanel.hidden = false;
    resultPanel.hidden = true;
    errorPanel.hidden = true;

    try {
      const result = await compressToSize(currentFile, targetKB, {
        format,
        onProgress: (i, total, currentKB) => {
          const pct = Math.round((i / total) * 100);
          progressFill.style.width = `${pct}%`;
          progressText.textContent = `Iteration ${i}/${total} — ${currentKB.toFixed(1)} KB`;
        },
      });

      resultBlob = result.blob;

      // Update preview with result
      if (previewURL) URL.revokeObjectURL(previewURL);
      previewURL = createPreviewURL(result.blob);
      previewImg.src = previewURL;

      // Show result
      const meta = await getImageMetadata(currentFile);
      setText('result-original', `${meta.sizeKB} KB`);
      setText('result-target', `≤ ${targetKB} KB`);
      setText('result-size', `${result.sizeKB} KB`);
      setText('result-quality', `${Math.round(result.quality * 100)}%`);

      const statusEl = document.getElementById('result-status');
      if (result.success) {
        statusEl.className = 'alert alert-success';
        statusEl.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>${result.message}</span>`;
        downloadBtn.hidden = false;
      } else {
        statusEl.className = 'alert alert-warning';
        statusEl.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span>${result.message}</span>`;
        downloadBtn.hidden = false;
        downloadBtn.textContent = `Download (${result.sizeKB} KB)`;
      }

      resultPanel.hidden = false;
      newFileBtn.hidden = false;
    } catch (err) {
      showError(`Processing error: ${err.message}`);
    } finally {
      compressBtn.disabled = false;
      compressBtn.textContent = 'Compress Image';
      progressPanel.hidden = true;
    }
  }

  function resetUI() {
    currentFile = null;
    resultBlob = null;
    if (previewURL) {
      URL.revokeObjectURL(previewURL);
      previewURL = null;
    }
    uploadArea.hidden = false;
    workspace.hidden = true;
    resultPanel.hidden = true;
    downloadBtn.hidden = true;
    newFileBtn.hidden = true;
    progressPanel.hidden = true;
    errorPanel.hidden = true;
    fileInput.value = '';
  }

  function showError(msg, type = 'error') {
    if (!msg) {
      errorPanel.hidden = true;
      return;
    }
    errorPanel.hidden = false;
    errorPanel.className = `alert alert-${type}`;
    errorPanel.textContent = msg;
  }

  function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }
</script>

<style>
  .tool-header { margin-bottom: clamp(1.25rem, 3vw, 2rem); }
  .tool-header h1 { margin-bottom: var(--space-2); }
  .tool-header p { color: var(--color-text-secondary); font-size: clamp(0.875rem, 1.5vw + 0.4rem, 1rem); }
  .compress-app {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
  }

  .controls-title {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .control-group {
    margin-bottom: var(--space-4);
  }

  .target-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
  }

  .target-prefix,
  .target-suffix {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
  }

  .target-input {
    flex: 1;
    max-width: 140px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: var(--font-semibold);
  }

  .quick-targets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .quick-target {
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .progress-text {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    text-align: center;
  }
</style>

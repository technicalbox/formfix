---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resize Image — Change Dimensions to Exact Pixels | FormFix"
  description="Resize images to exact pixel dimensions for exam and government application uploads. Free, instant, processed in your browser."
>
  <section class="section">
    <div class="container">
      <div class="tool-header">
        <h1>Resize Image</h1>
        <p>Resize your image to exact pixel dimensions required by application portals. High-quality downscaling — processed entirely in your browser.</p>
      </div>

      <div id="resize-app">
        <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label="Upload image">
          <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="upload-zone-text">Drop image here or click to upload</span>
          <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB</span>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden />
        </div>

        <div id="workspace" class="workspace" hidden>
          <div class="workspace-preview">
            <img id="preview-img" alt="Image preview" />
          </div>
          <div class="workspace-controls">
            <div class="card">
              <h3 class="controls-title">Original</h3>
              <dl class="file-info">
                <dt>Dimensions</dt><dd id="orig-dim">—</dd>
                <dt>Size</dt><dd id="orig-size">—</dd>
              </dl>
            </div>
            <div class="card">
              <h3 class="controls-title">Target Dimensions</h3>
              <div class="dim-inputs">
                <div class="dim-field">
                  <label class="label" for="target-w">Width (px)</label>
                  <input type="number" id="target-w" class="input" min="1" max="10000" placeholder="200" />
                </div>
                <span class="dim-x">×</span>
                <div class="dim-field">
                  <label class="label" for="target-h">Height (px)</label>
                  <input type="number" id="target-h" class="input" min="1" max="10000" placeholder="230" />
                </div>
              </div>
              <label class="checkbox-row">
                <input type="checkbox" id="lock-ratio" checked />
                <span>Maintain aspect ratio</span>
              </label>
              <button id="resize-btn" class="btn btn-primary" style="width:100%;margin-top:var(--space-4)">Resize</button>
            </div>
            <div id="result-panel" class="card" hidden>
              <h3 class="controls-title">Result</h3>
              <dl class="file-info">
                <dt>Dimensions</dt><dd id="res-dim">—</dd>
                <dt>Size</dt><dd id="res-size">—</dd>
              </dl>
              <button id="download-btn" class="btn btn-success" style="width:100%;margin-top:var(--space-3)" hidden>Download</button>
            </div>
            <button id="new-file-btn" class="btn btn-ghost" style="width:100%" hidden>Process Another File</button>
          </div>
        </div>
        <div id="error-panel" class="alert alert-error" role="alert" hidden></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { validateFile, resizeImage, getImageMetadata, createPreviewURL, downloadFile, getExtension } from '../../lib/image-engine.js';

  const uploadArea = document.getElementById('upload-area');
  const fileInput = document.getElementById('file-input');
  const workspace = document.getElementById('workspace');
  const previewImg = document.getElementById('preview-img');
  const resizeBtn = document.getElementById('resize-btn');
  const downloadBtn = document.getElementById('download-btn');
  const newFileBtn = document.getElementById('new-file-btn');
  const targetW = document.getElementById('target-w');
  const targetH = document.getElementById('target-h');
  const lockRatio = document.getElementById('lock-ratio');
  const resultPanel = document.getElementById('result-panel');
  const errorPanel = document.getElementById('error-panel');

  let currentFile = null;
  let resultBlob = null;
  let previewURL = null;
  let origWidth = 0, origHeight = 0;
  let settingDim = false;

  uploadArea?.addEventListener('click', () => fileInput?.click());
  uploadArea?.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput?.click(); } });
  uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
  uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea?.addEventListener('drop', (e) => { e.preventDefault(); uploadArea.classList.remove('drag-over'); if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]); });
  fileInput?.addEventListener('change', (e) => { if (e.target.files?.[0]) handleFile(e.target.files[0]); });

  targetW?.addEventListener('input', () => {
    if (lockRatio?.checked && !settingDim && origWidth > 0) {
      settingDim = true;
      targetH.value = Math.round((parseInt(targetW.value) / origWidth) * origHeight) || '';
      settingDim = false;
    }
  });
  targetH?.addEventListener('input', () => {
    if (lockRatio?.checked && !settingDim && origHeight > 0) {
      settingDim = true;
      targetW.value = Math.round((parseInt(targetH.value) / origHeight) * origWidth) || '';
      settingDim = false;
    }
  });

  resizeBtn?.addEventListener('click', handleResize);
  downloadBtn?.addEventListener('click', () => {
    if (resultBlob && currentFile) {
      const ext = getExtension(currentFile.type);
      downloadFile(resultBlob, `${currentFile.name.replace(/\.[^.]+$/, '')}_resized.${ext}`);
    }
  });
  newFileBtn?.addEventListener('click', resetUI);

  async function handleFile(file) {
    errorPanel.hidden = true;
    const v = await validateFile(file);
    if (!v.valid) { errorPanel.hidden = false; errorPanel.textContent = v.errors.join(' '); return; }
    currentFile = file;
    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = createPreviewURL(file);
    previewImg.src = previewURL;
    const meta = await getImageMetadata(file);
    origWidth = meta.width; origHeight = meta.height;
    document.getElementById('orig-dim').textContent = `${meta.width} × ${meta.height} px`;
    document.getElementById('orig-size').textContent = `${meta.sizeKB} KB`;
    targetW.value = meta.width; targetH.value = meta.height;
    uploadArea.hidden = true; workspace.hidden = false;
    resultPanel.hidden = true; downloadBtn.hidden = true; newFileBtn.hidden = true;
  }

  async function handleResize() {
    if (!currentFile) return;
    const w = parseInt(targetW.value); const h = parseInt(targetH.value);
    if (!w || !h || w < 1 || h < 1) { errorPanel.hidden = false; errorPanel.textContent = 'Enter valid dimensions.'; return; }
    resizeBtn.disabled = true; resizeBtn.textContent = 'Resizing...';
    try {
      const result = await resizeImage(currentFile, w, h, { format: currentFile.type });
      resultBlob = result.blob;
      if (previewURL) URL.revokeObjectURL(previewURL);
      previewURL = createPreviewURL(result.blob);
      previewImg.src = previewURL;
      document.getElementById('res-dim').textContent = `${result.width} × ${result.height} px`;
      document.getElementById('res-size').textContent = `${(result.blob.size / 1024).toFixed(1)} KB`;
      resultPanel.hidden = false; downloadBtn.hidden = false; newFileBtn.hidden = false;
    } catch (err) { errorPanel.hidden = false; errorPanel.textContent = err.message; }
    finally { resizeBtn.disabled = false; resizeBtn.textContent = 'Resize'; }
  }

  function resetUI() {
    currentFile = null; resultBlob = null;
    if (previewURL) { URL.revokeObjectURL(previewURL); previewURL = null; }
    uploadArea.hidden = false; workspace.hidden = true;
    resultPanel.hidden = true; downloadBtn.hidden = true; newFileBtn.hidden = true;
    errorPanel.hidden = true; fileInput.value = '';
  }
</script>

<style>
  .tool-header { margin-bottom: clamp(1.25rem, 3vw, 2rem); }
  .tool-header h1 { margin-bottom: var(--space-2); }
  .tool-header p { color: var(--color-text-secondary); font-size: clamp(0.875rem, 1.5vw + 0.4rem, 1rem); }
  .controls-title { font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: var(--space-3); }
  .dim-inputs { display: flex; align-items: flex-end; gap: var(--space-2); margin-bottom: var(--space-3); width: 100%; }
  .dim-field { flex: 1; min-width: 0; }
  .dim-x { font-size: var(--text-base); color: var(--color-text-tertiary); padding-bottom: var(--space-2-5); flex-shrink: 0; }
  .checkbox-row { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); cursor: pointer; min-height: 44px; user-select: none; }
  .checkbox-row input { width: 20px; height: 20px; accent-color: var(--color-primary-600); flex-shrink: 0; }
</style>

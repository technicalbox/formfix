---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About FormFix — Independent Image Utility for Application Forms';
const pageDescription = 'Learn about FormFix, an independent, browser-local image utility for resizing, cropping, compressing, and validating application photos and signatures.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section">
    <div class="container content-container">
      <div class="tool-header">
        <h1>About FormFix</h1>
        <p class="lead-text">FormFix is an independent utility designed to help applicants prepare compliant digital photos, signatures, and documents for online examination and job application portals.</p>
      </div>

      <div class="card content-card">
        <h2>What FormFix Does</h2>
        <p>Online application portals often reject file uploads due to strict requirements for pixel dimensions, file size (in KB), aspect ratio, and file format. FormFix provides specialized tools to solve these exact problems directly in your browser:</p>
        
        <ul class="feature-list">
          <li><strong>Resize Image:</strong> Change width and height to exact pixel specifications required by application forms.</li>
          <li><strong>Crop Image:</strong> Aspect-ratio-locked and freeform cropping with intuitive drag, zoom, and pan controls.</li>
          <li><strong>Compress Image:</strong> Smart binary-search compression algorithm to reduce file size to ≤ target KB (e.g., 20 KB, 50 KB, 100 KB) without sacrificing visual quality.</li>
          <li><strong>Convert Format:</strong> Seamless conversion between JPG/JPEG, PNG, and WebP formats.</li>
          <li><strong>Exam Presets:</strong> Pre-configured specifications for major exams (SSC, UPSC, IBPS, NEET, JEE, RRB) to auto-apply required dimensions and file size limits.</li>
        </ul>
      </div>

      <div class="card content-card">
        <h2>Browser-Local Processing & Privacy Architecture</h2>
        <p>FormFix is built with a <strong>privacy-first architecture</strong>. All image processing operations — including resizing, cropping, compression, and validation — are performed entirely within your web browser using client-side JavaScript and HTML5 Canvas technology.</p>
        <p>Your uploaded photos, signatures, and documents are <strong>never uploaded to any external server</strong> or cloud storage. They remain strictly on your local device throughout the entire workflow.</p>
      </div>

      <div class="card content-card">
        <h2>Independent Service Disclaimer</h2>
        <p>FormFix is an <strong>independent utility website</strong> created solely to assist users with file preparation. FormFix is <strong>not affiliated with, endorsed by, or sponsored by any government organization, examination board, or testing agency</strong>, including but not limited to the Staff Selection Commission (SSC), Union Public Service Commission (UPSC), Institute of Banking Personnel Selection (IBPS), National Testing Agency (NTA), or Railway Recruitment Boards (RRB).</p>
        <p>All exam names, logos, and trademarks referenced on this site belong to their respective trademark owners. Official requirements are researched from publicly available notifications, but users are strongly advised to verify current requirements against the official notification for their specific exam before submitting an application.</p>
      </div>

      <div class="card content-card">
        <h2>Contact & Feedback</h2>
        <p>If you encounter issues, notice an outdated requirement for an exam preset, or have questions about how FormFix works, please visit our <a href="/contact">Contact Page</a> to get in touch with us.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-container {
    max-width: 768px;
    margin-inline: auto;
  }

  .lead-text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-2);
  }

  .content-card {
    margin-top: var(--space-6);
    padding: clamp(1.25rem, 3.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .content-card h2 {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-gray-900);
    letter-spacing: var(--tracking-tight);
  }

  .content-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
  }

  .feature-list {
    margin-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .feature-list strong {
    color: var(--color-text);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import presetData from '../data/presets.json';

export function getStaticPaths() {
  const paths = [];

  // Exam preset pages
  for (const preset of presetData.presets) {
    paths.push({
      params: { slug: preset.slug },
      props: { type: 'preset', preset },
    });
  }

  // Compression target pages
  for (const ct of presetData.compressionTargets) {
    paths.push({
      params: { slug: ct.slug },
      props: { type: 'compression', compression: ct },
    });
  }

  return paths;
}

const { type, preset, compression } = Astro.props;

// Build page metadata based on type
let pageTitle, pageDescription, structuredData;

if (type === 'preset' && preset) {
  pageTitle = `${preset.displayName} — ${preset.exam} ${preset.type === 'photo' ? 'Photo' : 'Signature'} Size & Format | FormFix`;
  pageDescription = preset.description;

  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `How to ${preset.type === 'photo' ? 'Resize Photo' : 'Resize Signature'} for ${preset.exam}`,
    step: [
      { '@type': 'HowToStep', name: `Upload your ${preset.type}`, text: `Click the upload area or drag and drop your ${preset.type} image.` },
      { '@type': 'HowToStep', name: 'Auto-resize and compress', text: `FormFix automatically resizes and compresses your ${preset.type} to meet ${preset.exam} requirements.` },
      { '@type': 'HowToStep', name: 'Validate and download', text: 'Check that all requirements pass, then download your compliant file.' },
    ],
  };
}

if (type === 'compression' && compression) {
  pageTitle = `${compression.title} — Free Online Compressor | FormFix`;
  pageDescription = compression.description;

  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `How to ${compression.title}`,
    step: [
      { '@type': 'HowToStep', name: 'Upload your image', text: 'Click the upload area or drag and drop a JPG, PNG, or WebP image.' },
      { '@type': 'HowToStep', name: 'Compress', text: `FormFix automatically compresses your image to ≤ ${compression.targetKB} KB using smart quality optimization.` },
      { '@type': 'HowToStep', name: 'Download', text: 'Download the compressed image and upload it to your application portal.' },
    ],
  };
}

// Build requirements display for presets
function formatRequirements(req) {
  const items = [];
  if (req.format?.length) items.push({ label: 'Format', value: req.format.map(f => f.toUpperCase()).join(' / ') });
  if (req.dimensions?.width && req.dimensions?.height) items.push({ label: 'Dimensions', value: `${req.dimensions.width} × ${req.dimensions.height} px` });
  if (req.dimensions?.minWidth) items.push({ label: 'Min Width', value: `${req.dimensions.minWidth} px` });
  if (req.dimensions?.minHeight) items.push({ label: 'Min Height', value: `${req.dimensions.minHeight} px` });
  if (req.dimensions?.maxWidth) items.push({ label: 'Max Width', value: `${req.dimensions.maxWidth} px` });
  if (req.dimensions?.maxHeight) items.push({ label: 'Max Height', value: `${req.dimensions.maxHeight} px` });
  if (req.fileSize?.min != null && req.fileSize?.max != null) items.push({ label: 'File Size', value: `${req.fileSize.min}–${req.fileSize.max} ${req.fileSize.unit}` });
  else if (req.fileSize?.max != null) items.push({ label: 'Max Size', value: `≤ ${req.fileSize.max} ${req.fileSize.unit}` });
  return items;
}

// Related presets
const relatedPresets = type === 'preset' && preset?.relatedPresets
  ? presetData.presets.filter(p => preset.relatedPresets.includes(p.id))
  : [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <section class="section">
    <div class="container">

      {/* ── PRESET PAGE ── */}
      {type === 'preset' && preset && (
        <>
          <div class="tool-header">
            <div class="breadcrumb">
              <a href="/">Home</a> <span class="breadcrumb-sep">/</span>
              <span>{preset.exam}</span>
            </div>
            <h1>{preset.displayName}</h1>
            <p>{preset.description}</p>
          </div>

          {/* Requirements table */}
          <div class="requirements-card card">
            <h2 class="req-title">Official Requirements</h2>
            <dl class="req-grid">
              {formatRequirements(preset.requirements).map(item => (
                <>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </>
              ))}
            </dl>
            <div class="req-source">
              Source: <a href={preset.source.url} target="_blank" rel="noopener noreferrer">{preset.source.document}</a>
              <span class="req-date">· Researched {preset.source.verifiedDate}</span>
              {preset.source.status === 'needs-verification' && (
                <span class="badge badge-warning" style="margin-left:var(--space-2);">Needs verification</span>
              )}
            </div>
            {preset.source.status === 'needs-verification' && (
              <div class="alert alert-warning" style="margin-top:var(--space-3);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>These requirements were researched from official sources but should be verified against the current {preset.source.notificationYear} notification before submitting your application.</span>
              </div>
            )}
          </div>

          {/* Tool */}
          <div class="tool-section" id="preset-tool-section">
            <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label={`Upload ${preset.type} image`}>
              <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <span class="upload-zone-text">Upload your {preset.type}</span>
              <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB</span>
              <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden />
            </div>

            <div id="workspace" class="workspace" hidden>
              <div class="workspace-preview">
                <img id="preview-img" alt={`${preset.type} preview`} />
              </div>
              <div class="workspace-controls">
                <div class="card">
                  <h3 class="controls-title">Original</h3>
                  <dl class="file-info">
                    <dt>Dimensions</dt><dd id="orig-dim">—</dd>
                    <dt>Size</dt><dd id="orig-size">—</dd>
                    <dt>Format</dt><dd id="orig-fmt">—</dd>
                  </dl>
                </div>
                <button id="process-btn" class="btn btn-primary" style="width:100%">
                  Fix for {preset.exam}
                </button>
                <div id="progress-panel" hidden>
                  <div class="progress-bar"><div class="progress-bar-fill" id="progress-fill" style="width:0%"></div></div>
                  <p class="progress-text" id="progress-text">Processing...</p>
                </div>
                <div id="validation-panel" hidden>
                  <h3 class="controls-title">Validation</h3>
                  <div id="validation-results"></div>
                </div>
                <div id="result-panel" class="card" hidden>
                  <h3 class="controls-title">Result</h3>
                  <dl class="file-info">
                    <dt>Dimensions</dt><dd id="res-dim">—</dd>
                    <dt>Size</dt><dd id="res-size">—</dd>
                  </dl>
                  <button id="download-btn" class="btn btn-success" style="width:100%;margin-top:var(--space-3)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download
                  </button>
                </div>
                <button id="new-file-btn" class="btn btn-ghost" style="width:100%" hidden>Process Another File</button>
              </div>
            </div>
            <div id="error-panel" class="alert alert-error" role="alert" hidden></div>
          </div>

          {/* Guidelines */}
          {preset.guidelines?.length > 0 && (
            <div class="guidelines-section">
              <h2>{preset.exam} {preset.type === 'photo' ? 'Photo' : 'Signature'} Guidelines</h2>
              <ul class="guidelines-list">
                {preset.guidelines.map(g => <li>{g}</li>)}
              </ul>
              {preset.notes && <p class="guidelines-note">{preset.notes}</p>}
            </div>
          )}

          {/* Related */}
          {relatedPresets.length > 0 && (
            <div class="related-section">
              <h2>Related Tools</h2>
              <div class="related-grid">
                {relatedPresets.map(rp => (
                  <a href={`/${rp.slug}`} class="card card-interactive related-card">
                    <span class="badge badge-info">{rp.type}</span>
                    <h3>{rp.displayName}</h3>
                  </a>
                ))}
              </div>
            </div>
          )}
        </>
      )}

      {/* ── COMPRESSION PAGE ── */}
      {type === 'compression' && compression && (
        <>
          <div class="tool-header">
            <div class="breadcrumb">
              <a href="/">Home</a> <span class="breadcrumb-sep">/</span>
              <a href="/tools/compress">Compress</a> <span class="breadcrumb-sep">/</span>
              <span>≤ {compression.targetKB} KB</span>
            </div>
            <h1>{compression.title}</h1>
            <p>{compression.description}</p>
          </div>

          <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label="Upload image">
            <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="upload-zone-text">Drop image here or click to upload</span>
            <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB · Target: ≤ {compression.targetKB} KB</span>
            <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden />
          </div>

          <div id="workspace" class="workspace" hidden>
            <div class="workspace-preview">
              <img id="preview-img" alt="Image preview" />
            </div>
            <div class="workspace-controls">
              <div class="card">
                <h3 class="controls-title">Original</h3>
                <dl class="file-info">
                  <dt>Size</dt><dd id="orig-size">—</dd>
                  <dt>Dimensions</dt><dd id="orig-dim">—</dd>
                </dl>
              </div>
              <div id="progress-panel" hidden>
                <div class="progress-bar"><div class="progress-bar-fill" id="progress-fill" style="width:0%"></div></div>
                <p class="progress-text" id="progress-text">Compressing to ≤ {compression.targetKB} KB...</p>
              </div>
              <div id="result-panel" class="card" hidden>
                <h3 class="controls-title">Result</h3>
                <dl class="file-info">
                  <dt>Original</dt><dd id="res-orig">—</dd>
                  <dt>Result</dt><dd id="res-size">—</dd>
                </dl>
                <div id="result-status" class="alert" role="status" aria-live="polite"></div>
                <button id="download-btn" class="btn btn-success" style="width:100%;margin-top:var(--space-3)" hidden>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Download
                </button>
              </div>
              <button id="new-file-btn" class="btn btn-ghost" style="width:100%" hidden>Process Another File</button>
            </div>
          </div>
          <div id="error-panel" class="alert alert-error" role="alert" hidden></div>

          {compression.commonUses?.length > 0 && (
            <div class="common-uses">
              <h2>Common Uses</h2>
              <p>Images of ≤ {compression.targetKB} KB are commonly required for:</p>
              <ul>
                {compression.commonUses.map(use => <li>{use}</li>)}
              </ul>
            </div>
          )}

          <div class="other-targets">
            <h2>Other Compression Targets</h2>
            <div class="targets-row">
              {presetData.compressionTargets.filter(ct => ct.targetKB !== compression.targetKB).map(ct => (
                <a href={`/${ct.slug}`} class="btn btn-secondary">≤ {ct.targetKB} KB</a>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script define:vars={{ type, preset, compression, presetData: { presets: presetData.presets } }}>
  // Pass server-side data to client
  window.__FORMFIX_PAGE__ = { type, preset, compression };
</script>

<script>
  import { validateFile, resizeImage, compressToSize, getImageMetadata, createPreviewURL, downloadFile, getExtension } from '../lib/image-engine.js';
  import { validateAgainstPreset } from '../lib/validator.js';

  const pageData = window.__FORMFIX_PAGE__;
  const uploadArea = document.getElementById('upload-area');
  const fileInput = document.getElementById('file-input');
  const workspace = document.getElementById('workspace');
  const previewImg = document.getElementById('preview-img');
  const processBtn = document.getElementById('process-btn');
  const downloadBtn = document.getElementById('download-btn');
  const newFileBtn = document.getElementById('new-file-btn');
  const resultPanel = document.getElementById('result-panel');
  const progressPanel = document.getElementById('progress-panel');
  const progressFill = document.getElementById('progress-fill');
  const progressText = document.getElementById('progress-text');
  const errorPanel = document.getElementById('error-panel');

  let currentFile = null;
  let resultBlob = null;
  let previewURL = null;

  // Upload handlers
  uploadArea?.addEventListener('click', () => fileInput?.click());
  uploadArea?.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput?.click(); } });
  uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
  uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea?.addEventListener('drop', (e) => { e.preventDefault(); uploadArea.classList.remove('drag-over'); if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]); });
  fileInput?.addEventListener('change', (e) => { if (e.target.files?.[0]) handleFile(e.target.files[0]); });

  // Process button (preset pages)
  processBtn?.addEventListener('click', handlePresetProcess);

  // Download
  downloadBtn?.addEventListener('click', () => {
    if (resultBlob && currentFile) {
      const ext = getExtension(resultBlob.type || 'image/jpeg');
      const name = currentFile.name.replace(/\.[^.]+$/, '');
      downloadFile(resultBlob, `${name}_formfix.${ext}`);
    }
  });

  newFileBtn?.addEventListener('click', resetUI);

  async function handleFile(file) {
    hideError();
    const v = await validateFile(file);
    if (!v.valid) { showError(v.errors.join(' ')); return; }
    currentFile = file;

    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = createPreviewURL(file);
    if (previewImg) previewImg.src = previewURL;

    const meta = await getImageMetadata(file);
    setText('orig-dim', `${meta.width} × ${meta.height} px`);
    setText('orig-size', `${meta.sizeKB} KB`);
    setText('orig-fmt', file.type.replace('image/', '').toUpperCase());

    uploadArea.hidden = true;
    workspace.hidden = false;
    if (resultPanel) resultPanel.hidden = true;
    if (downloadBtn) downloadBtn.hidden = true;
    if (newFileBtn) newFileBtn.hidden = true;

    // Auto-compress for compression pages
    if (pageData.type === 'compression') {
      await handleCompressionProcess();
    }
  }

  async function handlePresetProcess() {
    if (!currentFile || !pageData.preset) return;
    const preset = pageData.preset;
    const req = preset.requirements;

    processBtn.disabled = true;
    processBtn.textContent = 'Processing...';
    progressPanel.hidden = false;

    try {
      let blob = currentFile;
      let width, height;

      const meta = await getImageMetadata(currentFile);
      width = meta.width;
      height = meta.height;

      // Step 1: Resize if dimensions are specified
      if (req.dimensions?.width && req.dimensions?.height) {
        progressText.textContent = 'Resizing...';
        progressFill.style.width = '30%';
        const resized = await resizeImage(currentFile, req.dimensions.width, req.dimensions.height, {
          format: 'image/jpeg',
        });
        blob = resized.blob;
        width = resized.width;
        height = resized.height;
      }

      // Step 2: Compress if file size target exists
      if (req.fileSize?.max) {
        progressText.textContent = 'Compressing...';
        const compressed = await compressToSize(blob, req.fileSize.max, {
          format: 'image/jpeg',
          onProgress: (i, total, kb) => {
            const pct = 30 + Math.round((i / total) * 60);
            progressFill.style.width = `${pct}%`;
            progressText.textContent = `Compressing... ${kb.toFixed(1)} KB`;
          },
        });
        blob = compressed.blob;
        width = compressed.width;
        height = compressed.height;
      }

      progressFill.style.width = '100%';
      progressText.textContent = 'Validating...';

      resultBlob = blob;

      // Update preview
      if (previewURL) URL.revokeObjectURL(previewURL);
      previewURL = createPreviewURL(blob);
      previewImg.src = previewURL;

      // Show result info
      const sizeKB = Math.round((blob.size / 1024) * 10) / 10;
      setText('res-dim', `${width} × ${height} px`);
      setText('res-size', `${sizeKB} KB`);

      // Validate
      const validation = validateAgainstPreset(
        { width, height, sizeKB, format: 'image/jpeg' },
        req
      );

      const validationResults = document.getElementById('validation-results');
      const validationPanel = document.getElementById('validation-panel');
      if (validationResults && validationPanel) {
        validationPanel.hidden = false;
        validationResults.innerHTML = validation.results.map(r => `
          <div class="validation-item ${r.pass ? 'validation-pass' : 'validation-fail'}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              ${r.pass
                ? '<polyline points="20 6 9 17 4 12"/>'
                : '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>'
              }
            </svg>
            <span><strong>${r.label}:</strong> ${r.actual} ${r.pass ? '' : `(need ${r.expected})`}</span>
          </div>
        `).join('');
      }

      resultPanel.hidden = false;
      downloadBtn.hidden = false;
      newFileBtn.hidden = false;

    } catch (err) {
      showError(`Processing error: ${err.message}`);
    } finally {
      processBtn.disabled = false;
      processBtn.textContent = `Fix for ${pageData.preset.exam}`;
      progressPanel.hidden = true;
    }
  }

  async function handleCompressionProcess() {
    if (!currentFile || !pageData.compression) return;
    const targetKB = pageData.compression.targetKB;

    progressPanel.hidden = false;
    progressText.textContent = `Compressing to ≤ ${targetKB} KB...`;

    try {
      const meta = await getImageMetadata(currentFile);
      setText('res-orig', `${meta.sizeKB} KB`);

      const result = await compressToSize(currentFile, targetKB, {
        format: 'image/jpeg',
        onProgress: (i, total, kb) => {
          const pct = Math.round((i / total) * 100);
          progressFill.style.width = `${pct}%`;
          progressText.textContent = `Iteration ${i}/${total} — ${kb.toFixed(1)} KB`;
        },
      });

      resultBlob = result.blob;
      if (previewURL) URL.revokeObjectURL(previewURL);
      previewURL = createPreviewURL(result.blob);
      previewImg.src = previewURL;

      setText('res-size', `${result.sizeKB} KB`);

      const statusEl = document.getElementById('result-status');
      if (result.success) {
        statusEl.className = 'alert alert-success';
        statusEl.textContent = result.message;
        downloadBtn.hidden = false;
      } else {
        statusEl.className = 'alert alert-warning';
        statusEl.textContent = result.message;
        downloadBtn.hidden = false;
      }

      resultPanel.hidden = false;
      newFileBtn.hidden = false;
    } catch (err) {
      showError(`Processing error: ${err.message}`);
    } finally {
      progressPanel.hidden = true;
    }
  }

  function resetUI() {
    currentFile = null; resultBlob = null;
    if (previewURL) { URL.revokeObjectURL(previewURL); previewURL = null; }
    uploadArea.hidden = false; workspace.hidden = true;
    if (resultPanel) resultPanel.hidden = true;
    if (downloadBtn) downloadBtn.hidden = true;
    if (newFileBtn) newFileBtn.hidden = true;
    if (progressPanel) progressPanel.hidden = true;
    const vp = document.getElementById('validation-panel');
    if (vp) vp.hidden = true;
    hideError(); fileInput.value = '';
  }

  function showError(msg) { if (errorPanel) { errorPanel.hidden = false; errorPanel.textContent = msg; } }
  function hideError() { if (errorPanel) errorPanel.hidden = true; }
  function setText(id, text) { const el = document.getElementById(id); if (el) el.textContent = text; }
</script>

<style>
  .tool-header { margin-bottom: clamp(1.25rem, 3vw, 2rem); }
  .tool-header h1 { margin-bottom: var(--space-2); }
  .tool-header p { color: var(--color-text-secondary); font-size: clamp(0.875rem, 1.5vw + 0.4rem, 1rem); }

  .breadcrumb { font-size: var(--text-xs); color: var(--color-text-tertiary); margin-bottom: var(--space-2); display: flex; flex-wrap: wrap; align-items: center; }
  .breadcrumb a { color: var(--color-text-secondary); }
  .breadcrumb-sep { margin-inline: var(--space-1-5); }

  .controls-title { font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: var(--space-3); }

  .requirements-card { margin-bottom: var(--space-6); width: 100%; }
  .req-title { font-size: clamp(1rem, 2vw + 0.5rem, 1.25rem); margin-bottom: var(--space-3); }
  .req-grid { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-3); font-size: var(--text-sm); margin-bottom: var(--space-3); }
  .req-grid dt { color: var(--color-text-secondary); font-weight: var(--font-medium); }
  .req-grid dd { color: var(--color-text); font-family: var(--font-mono); font-weight: var(--font-semibold); word-break: break-word; }
  .req-source { font-size: var(--text-xs); color: var(--color-text-tertiary); word-break: break-word; line-height: 1.5; }
  .req-date { color: var(--color-text-tertiary); }

  .badge-warning { background-color: var(--color-warning-50); color: var(--color-warning-600); }

  .tool-section { margin-bottom: var(--space-8); width: 100%; }

  .progress-text { font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-2); text-align: center; }

  #validation-panel { margin-bottom: var(--space-2); }
  #validation-results { display: flex; flex-direction: column; gap: var(--space-2); }

  .guidelines-section { margin-top: clamp(2rem, 5vw, 3.5rem); }

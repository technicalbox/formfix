---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import presetData from '../data/presets.json';

const pageTitle = 'Check Image Requirements Online — FormFix';
const pageDescription = 'Upload your photo or signature to instantly check whether it meets official exam portal size, dimensions, format, and aspect ratio requirements. 100% free & browser-local.';

const presets = presetData.presets;

const popularPresets = presets.filter(p => [
  'ibps-photo',
  'ssc-signature',
  'upsc-photo',
  'neet-photo',
  'jee-photo',
  'rrb-photo'
].includes(p.id));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'FormFix Check My Image',
  description: pageDescription,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  browserRequirements: 'Requires a modern web browser with JavaScript enabled',
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-heading">Check My Image</h1>
      <p class="hero-sub">
        Upload your photo or signature to instantly verify if it satisfies your required file size, dimensions, format, and aspect ratio limits.
      </p>

      <div class="hero-privacy">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Files stay in your browser — never uploaded
      </div>
    </div>
  </section>

  <!-- Main Diagnostic App Section -->
  <section class="section">
    <div class="container">
      <div id="validator-app" class="validator-app">

        <!-- Step 1: Upload Zone -->
        <div id="upload-area" class="upload-zone" role="button" tabindex="0" aria-label="Upload image — JPG, PNG, or WebP, maximum 25 MB">
          <svg class="upload-zone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="upload-zone-text">Drop photo or signature here, or click to upload</span>
          <span class="upload-zone-hint">JPG, PNG, or WebP · Max 25 MB</span>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" hidden aria-label="Choose image file" />
        </div>

        <!-- Workspace (Hidden until file is selected) -->
        <div id="workspace" class="workspace" hidden>

          <!-- Left Column: Preview & Original Specs -->
          <div class="workspace-preview-col">
            <div class="workspace-preview card">
              <h3 class="controls-title">Image Preview</h3>
              <div class="preview-img-container">
                <img id="preview-img" alt="Uploaded image preview" />
              </div>
            </div>

            <div class="card">
              <h3 class="controls-title">Original File Metadata</h3>
              <dl class="file-info" id="file-info-dl">
                <dt>Filename</dt><dd id="orig-name">—</dd>
                <dt>Dimensions</dt><dd id="orig-dim">—</dd>
                <dt>File Size</dt><dd id="orig-size">—</dd>
                <dt>Format</dt><dd id="orig-format">—</dd>
              </dl>
            </div>
          </div>

          <!-- Right Column: Requirement Selection & Controls -->
          <div class="workspace-controls-col">
            <div class="card requirement-selector-card">
              <h3 class="controls-title">Select Requirements to Check</h3>

              <!-- Selector Mode Switch Tabs -->
              <div class="tab-switch">
                <button type="button" class="tab-btn active" id="tab-preset-btn">Official Presets</button>
                <button type="button" class="tab-btn" id="tab-custom-btn">Custom Requirements</button>
              </div>

              <!-- Mode A: Preset Selector -->
              <div id="preset-mode-panel" class="tab-panel">
                <div class="control-group">
                  <label class="label" for="preset-search">Search Exam or Application Preset</label>
                  <input type="text" id="preset-search" class="input" placeholder="Type exam name (e.g., SSC, IBPS, UPSC, NEET)..." />
                </div>

                <div class="preset-popular-chips">
                  <span class="chips-label">Popular:</span>
                  <div class="chips-row">
                    {popularPresets.map(p => (
                      <button type="button" class="btn btn-xs btn-ghost preset-chip" data-id={p.id}>
                        {p.displayName.replace(' Resizer', '')}
                      </button>
                    ))}
                  </div>
                </div>

                <div class="control-group" style="margin-top:var(--space-3)">
                  <label class="label" for="preset-select">Requirement Preset</label>
                  <select id="preset-select" class="input">
                    {presets.map(p => (
                      <option value={p.id}>{p.exam} — {p.displayName} ({p.requirements.fileSize.max ? `≤ ${p.requirements.fileSize.max} KB` : 'Specs'})</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Mode B: Custom Requirements Form -->
              <div id="custom-mode-panel" class="tab-panel" hidden>
                <div class="custom-grid">
                  <div class="control-group">
                    <label class="label" for="custom-max-size">Max File Size</label>
                    <div class="input-with-unit">
                      <input type="number" id="custom-max-size" class="input" placeholder="50" min="1" max="50000" />
                      <select id="custom-size-unit" class="input input-unit">
                        <option value="KB">KB</option>
                        <option value="MB">MB</option>
                      </select>
                    </div>
                  </div>

                  <div class="control-group">
                    <label class="label" for="custom-format">Required Format</label>
                    <select id="custom-format" class="input">
                      <option value="any">Any (JPG / PNG / WebP)</option>
                      <option value="jpg">JPG / JPEG (recommended)</option>
                      <option value="png">PNG</option>
                      <option value="webp">WebP</option>
                    </select>
                  </div>

                  <div class="control-group">
                    <label class="label" for="custom-width">Exact Width (px)</label>
                    <input type="number" id="custom-width" class="input" placeholder="200" min="1" max="10000" />
                  </div>

                  <div class="control-group">
                    <label class="label" for="custom-height">Exact Height (px)</label>
                    <input type="number" id="custom-height" class="input" placeholder="230" min="1" max="10000" />
                  </div>

                  <div class="control-group">
                    <label class="label" for="custom-max-w">Max Width (px)</label>
                    <input type="number" id="custom-max-w" class="input" placeholder="Optional" min="1" max="10000" />
                  </div>

                  <div class="control-group">
                    <label class="label" for="custom-max-h">Max Height (px)</label>
                    <input type="number" id="custom-max-h" class="input" placeholder="Optional" min="1" max="10000" />
                  </div>
                </div>
              </div>

              <!-- Run Check Trigger -->
              <button id="run-check-btn" class="btn btn-primary" style="width:100%;margin-top:var(--space-4)">
                Check Image
              </button>
            </div>

            <!-- Progress Panel -->
            <div id="progress-panel" hidden>
              <div class="progress-bar">
                <div class="progress-bar-fill" id="progress-fill" style="width:0%"></div>
              </div>
              <p class="progress-text" id="progress-text">Analyzing file properties...</p>
            </div>

            <!-- Diagnostic Results Panel -->
            <div id="results-panel" class="card results-card" hidden>
              <div id="results-header" class="results-header">
                <!-- Populated dynamically via JS -->
              </div>

              <div id="checks-list" class="checks-list">
                <!-- Check cards inserted here -->
              </div>

              <!-- Quality Warning Alert -->
              <div id="quality-alert" class="alert alert-warning" hidden style="margin-top:var(--space-3);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                  <line x1="12" y1="9" x2="12" y2="13"/>
                  <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <span id="quality-alert-text">Target achieved, but compression quality is low.</span>
              </div>

              <!-- Primary Action Group -->
              <div class="action-buttons-group">
                <button id="fix-all-btn" class="btn btn-primary btn-lg" style="width:100%" hidden>
                  ⚡ Fix All Failures Automatically
                </button>

                <button id="download-btn" class="btn btn-success btn-lg" style="width:100%" hidden>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  Download Compliant File
                </button>
              </div>

              <!-- Process Another File -->
              <button id="new-file-btn" class="btn btn-ghost" style="width:100%;margin-top:var(--space-2)">
                Process Another File
              </button>
            </div>

            <!-- Validation Check Receipt Card (Shown on All Pass) -->
            <div id="receipt-card" class="card receipt-card" hidden>
              <div class="receipt-header">
                <span class="badge badge-success">FormFix Check Receipt</span>
                <span class="receipt-status-badge">✅ PASS</span>
              </div>

              <h3 id="receipt-title" class="receipt-title">Requirement Compliance Verified</h3>
              
              <dl class="receipt-grid">
                <dt>Preset</dt><dd id="receipt-preset-name">—</dd>
                <dt>File Name</dt><dd id="receipt-file-name">—</dd>
                <dt>Dimensions</dt><dd id="receipt-dim">—</dd>
                <dt>File Size</dt><dd id="receipt-size">—</dd>
                <dt>Format</dt><dd id="receipt-format">—</dd>
                <dt>Source</dt><dd id="receipt-source">—</dd>
                <dt>Verified On</dt><dd id="receipt-date">—</dd>
              </dl>

              <div class="receipt-disclaimer">
                Passing these technical checks confirms file compliance with recorded portal specifications. FormFix is an independent utility not affiliated with any exam authority. Please verify against official notifications before submitting.
              </div>
            </div>

          </div>
        </div>

        <!-- Error display -->
        <div id="error-panel" class="alert alert-error" role="alert" hidden></div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <h2 id="how-heading" class="section-heading">How Image Checking Works</h2>
      <div class="steps-grid" style="margin-top:var(--space-4)">
        <div class="step">
          <div class="step-number">1</div>
          <h3 class="step-title">Upload & Read</h3>
          <p class="step-desc">Upload your photo or signature. FormFix extracts pixel dimensions, format, and exact file size locally in your browser.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3 class="step-title">Diagnose</h3>
          <p class="step-desc">FormFix compares your file against official portal presets or your custom requirements, highlighting passes and failures.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3 class="step-title">Auto-Fix & Download</h3>
          <p class="step-desc">Click "Fix All" to automatically resize, convert, and compress your image to satisfy every requirement, then download.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <h2 id="faq-heading" class="section-heading">Frequently Asked Questions</h2>
      <details class="faq-item">
        <summary>What checks does the validator perform?</summary>
        <div class="faq-answer">FormFix checks file size in KB/MB, exact pixel dimensions (width × height), minimum/maximum dimension bounds, aspect ratio, file format (JPG, PNG, WebP), and file loadability.</div>
      </details>
      <details class="faq-item">
        <summary>Can FormFix fix all failed checks automatically?</summary>
        <div class="faq-answer">Yes! FormFix can automatically resize incorrect dimensions, convert unsupported formats (e.g., PNG to JPG), and compress oversized files under your target size in one click.</div>
      </details>
      <details class="faq-item">
        <summary>Are my images sent to a server during validation?</summary>
        <div class="faq-answer">No. All validation and image transformations occur 100% inside your web browser using client-side JavaScript. Your files are never uploaded to any server.</div>
      </details>
      <details class="faq-item">
        <summary>Does passing the check guarantee application approval?</summary>
        <div class="faq-answer">FormFix checks technical file properties against official specifications. However, exam authorities may have subjective requirements (e.g. background color or clarity). Always review official notifications.</div>
      </details>
    </div>
  </section>

  <!-- Ad Slot -->
  <AdSlot slotId="check-image-bottom" format="responsive" />
</BaseLayout>

<script define:vars={{ presetsData: presets }}>
  window.__FORMFIX_PRESETS__ = presetsData;
</script>

<script>
  import {
    validateFile,
    getImageMetadata,
    createPreviewURL,
    downloadFile,
    formatBytes,
    getExtension,
    resizeImage,
    compressToSize,
    convertFormat,
  } from '../lib/image-engine.js';
  import { validateImageDetailed, planFixSequence } from '../lib/validator.js';

  // DOM Elements
  const uploadArea = document.getElementById('upload-area');
  const fileInput = document.getElementById('file-input');
  const workspace = document.getElementById('workspace');
  const previewImg = document.getElementById('preview-img');
  const origName = document.getElementById('orig-name');
  const origDim = document.getElementById('orig-dim');
  const origSize = document.getElementById('orig-size');
  const origFormat = document.getElementById('orig-format');

  const tabPresetBtn = document.getElementById('tab-preset-btn');
  const tabCustomBtn = document.getElementById('tab-custom-btn');
  const presetPanel = document.getElementById('preset-mode-panel');
  const customPanel = document.getElementById('custom-mode-panel');

  const presetSearch = document.getElementById('preset-search');
  const presetSelect = document.getElementById('preset-select');
  const presetChips = document.querySelectorAll('.preset-chip');

  const customMaxSize = document.getElementById('custom-max-size');
  const customSizeUnit = document.getElementById('custom-size-unit');
  const customFormat = document.getElementById('custom-format');
  const customWidth = document.getElementById('custom-width');
  const customHeight = document.getElementById('custom-height');
  const customMaxW = document.getElementById('custom-max-w');
  const customMaxH = document.getElementById('custom-max-h');

  const runCheckBtn = document.getElementById('run-check-btn');
  const resultsPanel = document.getElementById('results-panel');
  const resultsHeader = document.getElementById('results-header');
  const checksList = document.getElementById('checks-list');
  const fixAllBtn = document.getElementById('fix-all-btn');
  const downloadBtn = document.getElementById('download-btn');
  const newFileBtn = document.getElementById('new-file-btn');
  const progressPanel = document.getElementById('progress-panel');
  const progressFill = document.getElementById('progress-fill');
  const progressText = document.getElementById('progress-text');
  const errorPanel = document.getElementById('error-panel');
  const qualityAlert = document.getElementById('quality-alert');

  const receiptCard = document.getElementById('receipt-card');
  const receiptTitle = document.getElementById('receipt-title');
  const receiptPresetName = document.getElementById('receipt-preset-name');
  const receiptFileName = document.getElementById('receipt-file-name');
  const receiptDim = document.getElementById('receipt-dim');
  const receiptSize = document.getElementById('receipt-size');
  const receiptFormat = document.getElementById('receipt-format');
  const receiptSource = document.getElementById('receipt-source');
  const receiptDate = document.getElementById('receipt-date');

  const presetsList = window.__FORMFIX_PRESETS__ || [];

  let currentFile = null;
  let workingBlob = null; // Blob being transformed
  let currentMetadata = null;
  let previewURL = null;
  let activeMode = 'preset'; // 'preset' | 'custom'
  let latestValidation = null;

  // Upload Handlers
  uploadArea?.addEventListener('click', () => fileInput?.click());
  uploadArea?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput?.click();
    }
  });
  uploadArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('drag-over');
  });
  uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]);
  });
  fileInput?.addEventListener('change', (e) => {
    if (e.target.files?.[0]) handleFile(e.target.files[0]);
  });

  // Tab Switching
  tabPresetBtn?.addEventListener('click', () => setMode('preset'));
  tabCustomBtn?.addEventListener('click', () => setMode('custom'));

  function setMode(mode) {
    activeMode = mode;
    if (mode === 'preset') {
      tabPresetBtn.classList.add('active');
      tabCustomBtn.classList.remove('active');
      presetPanel.removeAttribute('hidden');
      customPanel.setAttribute('hidden', '');
    } else {
      tabCustomBtn.classList.add('active');
      tabPresetBtn.classList.remove('active');
      customPanel.removeAttribute('hidden');
      presetPanel.setAttribute('hidden', '');
    }
    if (currentFile) runValidation();
  }

  // Preset Filtering
  presetSearch?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    Array.from(presetSelect.options).forEach((opt) => {
      const match = opt.text.toLowerCase().includes(q);
      opt.style.display = match ? '' : 'none';
    });
  });

  presetChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const id = chip.dataset.id;
      if (presetSelect) presetSelect.value = id;
      if (currentFile) runValidation();
    });
  });

  presetSelect?.addEventListener('change', () => {
    if (currentFile) runValidation();
  });

  // Custom Form Live Triggers
  [customMaxSize, customSizeUnit, customFormat, customWidth, customHeight, customMaxW, customMaxH].forEach((el) => {
    el?.addEventListener('change', () => {
      if (currentFile && activeMode === 'custom') runValidation();
    });
  });

  runCheckBtn?.addEventListener('click', () => {
    if (currentFile) runValidation();
  });

  newFileBtn?.addEventListener('click', resetUI);

  downloadBtn?.addEventListener('click', () => {
    if (workingBlob && currentFile) {
      const ext = getExtension(workingBlob.type || 'image/jpeg');
      const name = currentFile.name.replace(/\.[^.]+$/, '');
      downloadFile(workingBlob, `${name}_formfix.${ext}`);
    }
  });

  fixAllBtn?.addEventListener('click', handleFixAll);

  // Core File Handling
  async function handleFile(file) {
    hideError();
    const v = await validateFile(file);
    if (!v.valid) {
      showError(v.errors.join(' '));
      return;
    }

    currentFile = file;
    workingBlob = file;
    currentMetadata = await getImageMetadata(file);

    // Render original metadata
    origName.textContent = currentFile.name;
    origDim.textContent = `${currentMetadata.width} × ${currentMetadata.height} px`;
    origSize.textContent = `${currentMetadata.sizeKB} KB`;
    origFormat.textContent = getExtension(currentMetadata.format).toUpperCase();

    // Render Preview
    updatePreview(workingBlob);

    // Show workspace
    uploadArea.setAttribute('hidden', '');
    workspace.removeAttribute('hidden');

    // Run initial validation
    await runValidation();
  }

  function updatePreview(blob) {
    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = createPreviewURL(blob);
    if (previewImg) previewImg.src = previewURL;
  }

  // Get active requirements object
  function getActiveRequirements() {
    if (activeMode === 'preset') {
      const selectedId = presetSelect.value;
      const preset = presetsList.find((p) => p.id === selectedId);
      return preset ? preset.requirements : {};
    } else {
      const maxVal = parseFloat(customMaxSize.value);
      const unit = customSizeUnit.value || 'KB';
      const fmtVal = customFormat.value;
      const wVal = parseInt(customWidth.value, 10);
      const hVal = parseInt(customHeight.value, 10);
      const maxWVal = parseInt(customMaxW.value, 10);
      const maxHVal = parseInt(customMaxH.value, 10);

      const req = {
        format: fmtVal !== 'any' ? [fmtVal] : null,
        dimensions: {
          width: isNaN(wVal) ? null : wVal,
          height: isNaN(hVal) ? null : hVal,
          maxWidth: isNaN(maxWVal) ? null : maxWVal,
          maxHeight: isNaN(maxHVal) ? null : maxHVal,
        },
        fileSize: {
          max: isNaN(maxVal) ? null : maxVal,
          unit: unit,
        },
      };
      return req;
    }
  }

  // Run Validation Diagnostic
  async function runValidation() {
    if (!workingBlob) return;

    showProgress('Evaluating file requirements...');
    const meta = await getImageMetadata(workingBlob);

    const reqs = getActiveRequirements();
    const validation = validateImageDetailed(meta, reqs);
    latestValidation = validation;

    hideProgress();
    renderResults(validation, reqs);
  }

  // Render Diagnostic Results UI
  function renderResults(validation, reqs) {
    resultsPanel.removeAttribute('hidden');
    checksList.innerHTML = '';
    qualityAlert.setAttribute('hidden', '');

    // Render Header Badge
    if (validation.allPass) {
      resultsHeader.innerHTML = `
        <div class="result-status-title pass">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-success-600)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>All Checks Passed</span>
        </div>
        <p class="result-status-sub">${validation.summary}</p>
      `;
      fixAllBtn.setAttribute('hidden', '');
      downloadBtn.removeAttribute('hidden');
      renderReceipt(reqs);
    } else {
      resultsHeader.innerHTML = `
        <div class="result-status-title fail">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-error-600)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span>${validation.failCount} Requirement Issue${validation.failCount > 1 ? 's' : ''} Found</span>
        </div>
        <p class="result-status-sub">${validation.summary}</p>
      `;
      downloadBtn.setAttribute('hidden', '');
      receiptCard.setAttribute('hidden', '');

      if (validation.canAutoFix) {
        fixAllBtn.removeAttribute('hidden');
      } else {
        fixAllBtn.setAttribute('hidden', '');
      }
    }

    // Render Check Item Cards
    validation.checks.forEach((c) => {
      const card = document.createElement('div');
      card.className = `check-card check-${c.status.toLowerCase()}`;

      let statusBadgeHtml = '';
      if (c.status === 'PASS') {
        statusBadgeHtml = '<span class="badge badge-success">PASS</span>';
      } else if (c.status === 'FAIL') {
        statusBadgeHtml = '<span class="badge badge-error">FAIL</span>';
      } else {
        statusBadgeHtml = '<span class="badge badge-warning">WARNING</span>';
      }

      let fixBtnHtml = '';
      if (c.status === 'FAIL' && c.fixAction) {
        fixBtnHtml = `<button type="button" class="btn btn-sm btn-secondary single-fix-btn" data-action="${c.fixAction}">Fix ${c.label}</button>`;
      }

      card.innerHTML = `
        <div class="check-card-header">
          <span class="check-card-title">${c.label}</span>
          ${statusBadgeHtml}
        </div>
        <div class="check-card-body">
          <div class="check-metric"><span class="metric-label">Actual:</span> <strong>${c.actual}</strong></div>
          <div class="check-metric"><span class="metric-label">Required:</span> <span>${c.expected}</span></div>
          <p class="check-explanation">${c.explanation}</p>
          ${fixBtnHtml}
        </div>
      `;

      checksList.appendChild(card);

      // Single Fix Action Listener
      const singleBtn = card.querySelector('.single-fix-btn');
      if (singleBtn) {
        singleBtn.addEventListener('click', () => handleSingleFix(c, reqs));
      }
    });
  }

  // Handle Single Fix
  async function handleSingleFix(check, reqs) {
    if (!workingBlob) return;

    try {
      showProgress(`Fixing ${check.label}...`);
      if (check.fixAction === 'resize' && check.fixParams) {
        const res = await resizeImage(workingBlob, check.fixParams.width, check.fixParams.height, {
          format: reqs.format ? `image/${reqs.format[0]}` : workingBlob.type,
        });
        workingBlob = res.blob;
      } else if (check.fixAction === 'convert' && check.fixParams) {
        const res = await convertFormat(workingBlob, check.fixParams.targetFormat);
        workingBlob = res.blob;
      } else if (check.fixAction === 'compress' && check.fixParams) {
        const res = await compressToSize(workingBlob, check.fixParams.targetKB, {
          format: reqs.format ? `image/${reqs.format[0]}` : workingBlob.type,
        });
        workingBlob = res.blob;
        if (res.quality < 0.35) {
          qualityAlert.removeAttribute('hidden');
        }
      }
      updatePreview(workingBlob);
      await runValidation();
    } catch (err) {
      showError(`Fix failed: ${err.message}`);
    } finally {
      hideProgress();
    }
  }

  // Handle "Fix All" Automated Sequence
  async function handleFixAll() {
    if (!workingBlob || !latestValidation) return;

    try {
      const reqs = getActiveRequirements();
      const plan = planFixSequence(latestValidation, reqs);

      if (plan.length === 0) return;

      for (let i = 0; i < plan.length; i++) {
        const step = plan[i];
        showProgress(`Step ${i + 1} of ${plan.length}: ${step.label}...`);

        if (step.type === 'resize') {
          const res = await resizeImage(workingBlob, step.params.width, step.params.height, { format: step.params.format });
          workingBlob = res.blob;
        } else if (step.type === 'convert') {
          const res = await convertFormat(workingBlob, step.params.targetFormat);
          workingBlob = res.blob;
        } else if (step.type === 'compress') {
          const res = await compressToSize(workingBlob, step.params.targetKB, {
            format: step.params.format,
            maxWidth: step.params.maxWidth,
            maxHeight: step.params.maxHeight,
          });
          workingBlob = res.blob;
          if (res.quality < 0.35) {
            qualityAlert.removeAttribute('hidden');
          }
        }
      }

      updatePreview(workingBlob);
      await runValidation();
    } catch (err) {
      showError(`Transformation sequence failed: ${err.message}`);
    } finally {
      hideProgress();
    }
  }

  // Render Check Receipt Card
  async function renderReceipt(reqs) {
    if (!workingBlob) return;
    const meta = await getImageMetadata(workingBlob);

    receiptCard.removeAttribute('hidden');

    if (activeMode === 'preset') {
      const selectedId = presetSelect.value;
      const preset = presetsList.find((p) => p.id === selectedId);
      receiptTitle.textContent = `${preset.displayName} — Compliance Verified`;
      receiptPresetName.textContent = preset.exam;
      receiptSource.innerHTML = `<a href="${preset.source.url}" target="_blank" rel="noopener noreferrer">${preset.source.document}</a>`;
      receiptDate.textContent = preset.source.verifiedDate;
    } else {
      receiptTitle.textContent = 'Custom Requirements — Compliance Verified';
      receiptPresetName.textContent = 'Custom User Specification';
      receiptSource.textContent = 'User Defined';
      receiptDate.textContent = new Date().toISOString().split('T')[0];
    }

    receiptFileName.textContent = currentFile.name;
    receiptDim.textContent = `${meta.width} × ${meta.height} px`;
    receiptSize.textContent = `${meta.sizeKB} KB`;
    receiptFormat.textContent = getExtension(meta.format).toUpperCase();
  }

  // Helpers & UI resets
  function showProgress(msg) {
    if (progressPanel) {
      progressPanel.removeAttribute('hidden');
      if (progressText) progressText.textContent = msg;
      if (progressFill) progressFill.style.width = '60%';
    }
  }

  function hideProgress() {
    if (progressPanel) progressPanel.setAttribute('hidden', '');
  }

  function showError(msg) {
    if (errorPanel) {
      errorPanel.textContent = msg;
      errorPanel.removeAttribute('hidden');
    }
  }

  function hideError() {
    if (errorPanel) errorPanel.setAttribute('hidden', '');
  }

  function resetUI() {
    currentFile = null;
    workingBlob = null;
    currentMetadata = null;
    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = null;
    latestValidation = null;

    if (fileInput) fileInput.value = '';
    workspace?.setAttribute('hidden', '');
    resultsPanel?.setAttribute('hidden', '');
    receiptCard?.setAttribute('hidden', '');
    uploadArea?.removeAttribute('hidden');
    hideError();
    hideProgress();
  }
</script>


---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage,
  structuredData,
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Structured Data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-nav">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="FormFix — Home">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="24" height="24" rx="6" stroke="currentColor" stroke-width="2"/>
            <path d="M8 10h12M8 14h8M8 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="5" fill="var(--color-success-600)" stroke="var(--color-surface)" stroke-width="2"/>
            <path d="M19 21l1.5 1.5L23 20" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="logo-text">FormFix</span>
        </a>

        <nav class="main-nav desktop-only" aria-label="Main navigation">
          <a href="/check-image">Check Image</a>
          <a href="/tools/resize">Resize</a>
          <a href="/tools/crop">Crop</a>
          <a href="/tools/compress">Compress</a>
          <a href="/tools/convert">Convert</a>
        </nav>

        <button
          class="mobile-menu-btn mobile-only"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          id="mobile-menu-toggle"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="icon-hamburger">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="icon-close" hidden>
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav mobile-only" id="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="container">
          <div class="mobile-nav-group">
            <span class="mobile-nav-label">Core Tools</span>
            <a href="/check-image">Check My Image</a>
            <a href="/tools/resize">Resize Image</a>
            <a href="/tools/crop">Crop Image</a>
            <a href="/tools/compress">Compress Image</a>
            <a href="/tools/convert">Convert Format</a>
          </div>
          <hr />
          <div class="mobile-nav-group">
            <span class="mobile-nav-label">Popular Exam Presets</span>
            <a href="/ibps-photo-resizer">IBPS Photo Resizer</a>
            <a href="/ssc-signature-resizer">SSC Signature Resizer</a>
            <a href="/upsc-photo-resizer">UPSC Photo Resizer</a>
            <a href="/neet-photo-resizer">NEET Photo Resizer</a>
            <a href="/jee-photo-resizer">JEE Photo Resizer</a>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div class="footer-col">
            <h3>Tools</h3>
            <a href="/tools/resize">Resize Image</a>
            <a href="/tools/crop">Crop Image</a>
            <a href="/tools/compress">Compress Image</a>
            <a href="/tools/convert">Convert Format</a>
          </div>
          <div class="footer-col">
            <h3>Exam Presets</h3>
            <a href="/ibps-photo-resizer">IBPS Photo</a>
            <a href="/ssc-signature-resizer">SSC Signature</a>
            <a href="/upsc-photo-resizer">UPSC Photo</a>
            <a href="/neet-photo-resizer">NEET Photo</a>
          </div>
          <div class="footer-col">
            <h3>Compress To</h3>
            <a href="/compress-image-to-20kb">≤ 20 KB</a>
            <a href="/compress-image-to-50kb">≤ 50 KB</a>
            <a href="/compress-image-to-100kb">≤ 100 KB</a>
            <a href="/compress-image-to-200kb">≤ 200 KB</a>
          </div>
          <div class="footer-col">
            <h3>About & Legal</h3>
            <a href="/about">About FormFix</a>
            <a href="/contact">Contact Us</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
        </div>

        <div class="footer-bottom">
          <div class="footer-privacy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Files are processed in your browser and never uploaded to any server.</span>
          </div>
          <p class="footer-copyright">&copy; {new Date().getFullYear()} FormFix. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('mobile-menu-toggle');
      const nav = document.getElementById('mobile-nav');
      const iconHamburger = toggle?.querySelector('.icon-hamburger');
      const iconClose = toggle?.querySelector('.icon-close');

      function setMenuState(open: boolean) {
        if (!toggle || !nav) return;
        toggle.setAttribute('aria-expanded', String(open));
        if (open) {
          nav.removeAttribute('hidden');
        } else {
          nav.setAttribute('hidden', '');
        }
        if (iconHamburger && iconClose) {
          if (open) {
            iconHamburger.setAttribute('hidden', '');
            iconClose.removeAttribute('hidden');
          } else {
            iconHamburger.removeAttribute('hidden');
            iconClose.setAttribute('hidden', '');
          }
        }
      }

      if (toggle && nav) {
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          setMenuState(!expanded);
        });

        // Close on ESC key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenuState(false);
          }
        });

        // Close when clicking outside
        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (toggle.getAttribute('aria-expanded') === 'true' && !nav.contains(target) && !toggle.contains(target)) {
            setMenuState(false);
          }
        });

        // Close when clicking a nav link
        nav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            setMenuState(false);
          });
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    position: relative;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    min-height: 44px;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-primary-600);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .main-nav.desktop-only {
      display: flex !important;
    }
  }

  .main-nav a {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .main-nav a:hover {
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .mobile-menu-btn:hover {
    background-color: var(--color-surface-muted);
  }

  .mobile-menu-btn:focus-visible {
    outline: 2px solid var(--color-border-focus);
  }

  .mobile-nav {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-md);
    padding-block: var(--space-4);
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: var(--z-dropdown);
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  .mobile-nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-nav-label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    padding: var(--space-1) var(--space-2);
    margin-bottom: var(--space-1);
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .mobile-nav a:hover,
  .mobile-nav a:focus {
    background-color: var(--color-primary-50);
    color: var(--color-primary-700);
    text-decoration: none;
  }

  .mobile-nav hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-3) 0;
  }

  /* Footer */
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
    gap: var(--space-6) var(--space-8);
    margin-bottom: var(--space-8);
  }

  .footer-col h3 {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-col a {
    display: flex;
    align-items: center;
    min-height: 36px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: var(--space-1);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--color-primary-600);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-privacy {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .footer-privacy svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  @media (min-width: 768px) {
    .header-inner {
      height: 64px;
    }
  }
</style>
